<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.islam.tv"
    android:versionCode="6"
    android:versionName="2.5" >

    <uses-sdk
        android:minSdkVersion="26"
        android:targetSdkVersion="34" />

    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.wifi"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.location.gps"
        android:required="false" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!--
         Needed since Android 10 to read the Wi-Fi network name for the network pill. Never requested at
         runtime: build-and-install grants it with pm grant, so lint's Android 12 "ask for COARSE with
         FINE" rule does not apply here.
    -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />

    <!--
         Android 11+ package visibility: lets the launcher list the TV apps it shows as tiles, and the
         apps that declare a module card (docs/specs/card.md).
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />

            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />

            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />

            <category android:name="com.islam.tv.category.DOCK_CARD" />
        </intent>
        <!-- China-market MIUI TV firmware: the Settings and Wi-Fi pills fall back to Xiaomi's settings app. -->
        <package android:name="com.xiaomi.mitv.settings" />
    </queries>

    <application
        android:allowBackup="false"
        android:appComponentFactory="androidx.core.app.CoreComponentFactory"
        android:banner="@drawable/banner"
        android:extractNativeLibs="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:theme="@style/Theme.TvHome" >
        <activity
            android:name="com.islam.tv.MainActivity"
            android:clearTaskOnLaunch="true"
            android:configChanges="orientation|screenSize|keyboard|keyboardHidden|uiMode"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:stateNotNeeded="true" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- Listed in the TV's own app list, so it can be opened from the stock home screen too. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name="com.islam.tv.LauncherSettingsActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:screenOrientation="landscape" />
        <!-- Remote Settings button panel (settings_key_panel); own task so the app behind stays put. -->
        <activity
            android:name="com.islam.tv.QuickSettingsActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTop"
            android:noHistory="true"
            android:screenOrientation="landscape"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar.Fullscreen" />
        <activity
            android:name="com.islam.tv.HomeSettingsActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:taskAffinity=""
            android:theme="@android:style/Theme.NoDisplay" />
        <!--
             Home button for remotes that send KEYCODE_ALL_APPS (Xiaomi). Opt-in: HOME_KEY_SERVICE=1
             build-and-install.sh; see HomeKeyService.
        -->
        <service
            android:name="com.islam.tv.HomeKeyService"
            android:exported="true"
            android:label="@string/home_key_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE" >
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>

            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/home_key_service" />
        </service>

        <!-- The same clock, started by Home itself after home_idle_clock_minutes without input. -->
        <activity
            android:name="com.islam.tv.ClockActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen" />

        <!--
             Screensaver: pick it in Settings, or `settings put secure screensaver_components
             com.islam.tv/.ClockDream` over adb.
        -->
        <service
            android:name="com.islam.tv.ClockDream"
            android:exported="true"
            android:label="@string/dream_name"
            android:permission="android.permission.BIND_DREAM_SERVICE" >
            <intent-filter>
                <action android:name="android.service.dreams.DreamService" />

                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>

        <!--
             tools/theme.sh writes the theme through this where the shell can't reach Android/data;
             see ThemeProvider. WRITE_SECURE_SETTINGS: the adb shell has it, ordinary apps don't.
        -->
        <provider
            android:name="com.islam.tv.ThemeProvider"
            android:authorities="com.islam.tv.theme"
            android:exported="true"
            android:permission="android.permission.WRITE_SECURE_SETTINGS" />

        <!--
         The remote's Input button (KEYCODE_TV or KEYCODE_TV_INPUT) opens the input switcher, and input_key_keycodes and
         app_keys (config.xml or a theme) bring back other remote buttons; see InputKeyService.
        -->
        <service
            android:name="com.islam.tv.InputKeyService"
            android:exported="false"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE" >
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>

            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/input_key_service" />
        </service>

        <activity
            android:name="com.islam.tv.PrayerSettingsActivity"
            android:exported="true"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.TvHome" />
        <activity
            android:name="com.islam.tv.WeatherSettingsActivity"
            android:exported="true"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.TvHome" />
        <activity
            android:name="com.islam.tv.ScreenSaverSettingsActivity"
            android:exported="true"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.TvHome" />
        <activity
            android:name="com.islam.tv.PrayerAlertActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:showWhenLocked="true"
            android:theme="@style/Theme.TranslucentAlert"
            android:turnScreenOn="true" />

        <service
            android:name="com.islam.tv.PrayerAlarmService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <receiver
            android:name="com.islam.tv.PrayerAlarmReceiver"
            android:exported="true" >
            <intent-filter>
                <action android:name="com.islam.tv.ACTION_PRAYER_ALARM" />
                <action android:name="com.islam.tv.ACTION_TEST_PRAYER_ALARM" />
                <action android:name="com.islam.tv.ACTION_TEST_SLEEP" />
                <action android:name="com.islam.tv.ACTION_TEST_SLEEP_AND_ALARM" />
            </intent-filter>
        </receiver>
        <receiver
            android:name="com.islam.tv.PrayerBootReceiver"
            android:exported="true" >
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>