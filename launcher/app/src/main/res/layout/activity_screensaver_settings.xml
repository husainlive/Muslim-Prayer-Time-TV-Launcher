<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF101419"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="72dp"
        android:paddingEnd="72dp"
        android:paddingTop="38dp"
        android:paddingBottom="48dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/screensaver_settings"
            android:textColor="#FFFFFFFF"
            android:textSize="34sp"
            android:fontFamily="@font/outfit_light" />

        <TextView
            android:id="@+id/screenSaverEnabledChoice"
            style="@style/SettingsRow"
            android:layout_marginTop="28dp" />

        <TextView
            android:id="@+id/screenSaverTimeoutChoice"
            style="@style/SettingsRow"
            android:layout_marginTop="10dp" />

        <TextView
            android:id="@+id/screenSaverAppChoice"
            style="@style/SettingsRow"
            android:layout_marginTop="10dp" />

        <TextView
            android:id="@+id/screenSaverPreviewChoice"
            style="@style/SettingsRow"
            android:layout_marginTop="10dp"
            android:text="@string/screensaver_preview" />

        <TextView
            android:id="@+id/screenSaverSystemChoice"
            style="@style/SettingsRow"
            android:layout_marginTop="10dp"
            android:text="@string/screensaver_system_settings" />
    </LinearLayout>
</ScrollView>
