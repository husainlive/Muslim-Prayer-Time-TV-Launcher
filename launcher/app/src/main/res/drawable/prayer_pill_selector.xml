<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#F5FFFFFF" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#386EC1FF"
                android:endColor="#186EC1FF" />
            <stroke
                android:width="1.5dp"
                android:color="#FF6EC1FF" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#26FFFFFF"
                android:endColor="#0EFFFFFF" />
            <stroke
                android:width="1dp"
                android:color="#26FFFFFF" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
